# Instagram publishing (phase 3). Copy this file to .env.local and fill it in there.
# .env.local is git-ignored. Never paste these values into a chat, an issue or a commit.

# From your Meta app. See docs/INSTAGRAM.md for how to get them.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Which login your app uses: "instagram" (graph.instagram.com, the simpler path)
# or "facebook" (graph.facebook.com, needs a linked Page and a Page token).
INSTAGRAM_LOGIN=instagram

# Bump this when Meta ships a new version; the app defaults to the one below.
INSTAGRAM_API_VERSION=v26.0

# Instagram fetches the media from a public URL rather than accepting an upload,
# so this must point at this app from the internet while a publish is running —
# e.g. the https address a cloudflared or ngrok tunnel gives you.
PUBLIC_MEDIA_BASE_URL=

# Optional. Signs the short-lived media links. Leave empty and one is generated
# per run; set it if you want links to survive a restart.
PUBLISH_MEDIA_SECRET=
