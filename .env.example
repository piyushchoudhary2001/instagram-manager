# Phase 1 (carousel studio + content manager) needs no environment variables.
# Everything below is reserved for Phase 3 (direct publishing + insights).
# Copy this file to .env.local and fill it in yourself. Never paste these values into a chat.

# Meta developer app (created by you at developers.facebook.com)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Long-lived access token for the professional Instagram account @build.it01
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Instagram fetches media from a public HTTPS URL when publishing.
# Point this at the tunnel or bucket that serves ./exports (for example an ngrok URL).
PUBLIC_MEDIA_BASE_URL=
